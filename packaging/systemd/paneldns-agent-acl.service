# paneldns-agent-acl.service: restores the agent's read ACLs
# (docs/DECISIONS.md D-30). Started by paneldns-agent-acl.path.
#
# Runs `paneldns-agent fix-acls` as root, the only part of the agent that
# does. It works out the same plan as enrol (named.conf, its includes except
# key-only files, zone files, journals, $INCLUDEd files, the owner file, the
# zone directories and their parents) and, where the agent lacks the access
# the plan grants, adds u:paneldns-agent:r (rx on directories, x on parents,
# the default ACL on zone directories) and raises the mask just enough. It
# never lowers a mask, never widens anyone else's access, never touches key
# files, and never rewrites unit files (--no-units): run fix-acls by hand
# to update the watch list.
#
# Local additions written by enrol: ReadWritePaths= for the planned paths in
# /etc/systemd/system/paneldns-agent-acl.service.d/watch.conf.

[Unit]
Description=PanelDNS agent: restore the agent's read ACLs
Documentation=https://github.com/hostingsimple/paneldns-agent/blob/main/docs/INSTALL.md
# Each run waits --settle first, so starts are spaced out on their own; the
# default start limit would only drop events.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# --settle: let the panel finish writing (zone file, then named.conf) and
# pass again while files keep needing a fix.
ExecStart=/usr/bin/paneldns-agent fix-acls --settle 3s --no-units
TimeoutStartSec=15min

# Identity: root, with only the capabilities setfacl on named's files needs.
#   CAP_DAC_READ_SEARCH  read named.conf, includes and zone files (to follow
#                        $INCLUDE and spot key files) and search directories
#                        owned by named, whatever their mode
#   CAP_FOWNER           set an ACL on a file root doesn't own (setting the
#                        system.posix_acl_* xattrs needs the owner or this)
#   CAP_FSETID           keep a setgid bit: setting an ACL on a file or
#                        directory whose group root isn't in clears setgid
#                        without it
# No CAP_DAC_OVERRIDE: it can't write files it doesn't own, and only the
# paths in ReadWritePaths= are writable at all.
User=root
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID
AmbientCapabilities=
NoNewPrivileges=yes
UMask=0077

# Filesystem: everything read-only; the drop-in adds ReadWritePaths= for the
# zone directories and each planned file or directory outside them, and
# ProtectHome=read-only when zones live under /home (HestiaCP).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

# Network: none. fix-acls opens no socket, and with no AF_UNIX it can't
# reach systemd or D-Bus either, so it can't change any unit.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=none

RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@chown @setuid
SystemCallErrorNumber=EPERM

MemoryMax=128M
TasksMax=16
Nice=10
